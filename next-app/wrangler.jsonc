{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pathik-waterbill",
  "account_id": "6bee60f0bc279ce71350c0066b8dbaf9",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pathik_db",
      "database_id": "da10750f-67c4-4ae6-9568-61092fcc9141"
    }
  ],
  "vars": {
    "JWT_SECRET": "pathik-sco-super-secret-jwt-key-2026"
  }
}
